{
  "slug": "design-critique",
  "title": "Design critique & brand color",
  "source": "A.Song Studio",
  "sourceNote": "Distilled from about 70 reels",
  "summary": "Name the one job, run the few recurring checks, fix at most three things.",
  "accent": "#600C49",
  "sections": [
    {
      "id": "critique",
      "title": "How to critique",
      "type": "steps",
      "tutorials": [
        {
          "title": "Critique flow",
          "steps": [
            "State the one job",
            "Two-second eye test + squint",
            "Name at most 3 issues",
            "Give a concrete fix, before and after",
            "Keep it short"
          ]
        }
      ]
    },
    {
      "id": "diagnostics",
      "title": "Diagnostics",
      "intro": "It looks X, so do Y.",
      "type": "diagnostics",
      "items": [
        {
          "symptom": "Messy",
          "fix": "Put everything on one grid",
          "viz": "grid"
        },
        {
          "symptom": "Chaotic",
          "fix": "Same job, same look",
          "viz": "group"
        },
        {
          "symptom": "Feels off",
          "fix": "Check grids, make one thing biggest",
          "viz": "focus"
        },
        {
          "symptom": "Doesn’t stand out",
          "fix": "Exaggerate scale contrast",
          "viz": "scale"
        },
        {
          "symptom": "Busy",
          "fix": "Take away before adding",
          "viz": "busy"
        },
        {
          "symptom": "Heavy",
          "fix": "Brighten, add one pop of color",
          "viz": "heavy"
        },
        {
          "symptom": "Empty",
          "fix": "Make one thing big",
          "viz": "empty"
        },
        {
          "symptom": "Boring",
          "fix": "Soft glow as a spotlight",
          "viz": "glow"
        },
        {
          "symptom": "Cold",
          "fix": "Warm the colors",
          "viz": "warm"
        },
        {
          "symptom": "Flat",
          "fix": "Texture, no pure black or white",
          "viz": "flat"
        },
        {
          "symptom": "Chaotic colors",
          "fix": "Make color the message",
          "viz": "message"
        },
        {
          "symptom": "Muddy",
          "fix": "Make one color much brighter",
          "viz": "muddy"
        },
        {
          "symptom": "Random",
          "fix": "Put the words in the picture",
          "viz": "words"
        }
      ]
    },
    {
      "id": "hierarchy",
      "title": "Hierarchy",
      "type": "cards",
      "items": [
        {
          "title": "One job",
          "text": "When you don’t know the point, you start decorating."
        },
        {
          "title": "Judge by the job",
          "text": "If people can’t tell what matters in a second, it failed."
        },
        {
          "title": "One loud color",
          "text": "Same-role elements share a color. Not six text colors."
        },
        {
          "title": "One big thing first",
          "text": "That’s where the eye starts."
        },
        {
          "title": "One simple symbol",
          "text": "Swap clutter so the text reads first, then a clear CTA."
        },
        {
          "title": "Two-second eye test",
          "text": "If your eye ping-pongs, the layout feels random."
        }
      ]
    },
    {
      "id": "gestalt",
      "title": "Layout & Gestalt",
      "type": "cards",
      "items": [
        {
          "title": "Similarity",
          "text": "Titles match titles, containers match containers."
        },
        {
          "title": "Proximity",
          "text": "Date with location, all details in one block."
        },
        {
          "title": "Frames",
          "text": "A frame turns its contents into one unit for the eye."
        }
      ],
      "short": "Gestalt"
    },
