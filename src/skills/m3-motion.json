  "overview": {
    "purpose": "Apply Material Design 3 motion tokens and patterns on the web.",
    "when": "Building with Material, or needing a ready duration and easing token set.",
    "takeaways": [
      "Standard for utility, expressive for hero moments",
      "Tokenise durations short / medium / long",
      "Container transform for continuity",
      "Stagger list items 30–50 ms"
    ],
