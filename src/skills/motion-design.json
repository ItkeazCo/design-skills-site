  "accent": "#B0603A",
  "summary": "Emotion, personality, timing and choreography for UI and illustration motion.",
  "overview": {
    "purpose": "Plan motion from the feeling it should create down to timing and easing.",
    "when": "Designing a motion language, illustrations, loaders or multi-element sequences.",
    "takeaways": [
      "Start from the emotion",
      "One personality per project",
      "Entrances longer than exits",
      "Few properties, few simultaneous elements"
    ],
    "start": "personality"
  },
  "sections": [
    {
      "id": "pillars",
      "title": "Three pillars",
      "type": "cards",
      "intro": "Answer these before any technical choice.",
      "items": [
        {
          "title": "Emotional intent",
          "text": "What should the viewer feel?",
          "more": "Drives easing, timing and amplitude."
        },
        {
          "title": "Visual narrative",
          "text": "What is the micro-story?",
          "more": "Setup, action, resolution."
        },
        {
          "title": "Motion craft",
          "text": "How is it believable?",
          "more": "Physics, secondary motion and paths."
        },
        {
          "title": "Three layers",
          "text": "Primary, secondary, ambient.",
          "more": "Flat animation usually means a missing layer."
        }
      ],
      "short": "Pillars"
    },
    {
      "id": "personality",
      "title": "Motion personality",
      "type": "cards",
      "intro": "Pick one archetype and apply it everywhere.",
      "items": [
        {
          "title": "Playful",
          "text": "150–300 ms, back easing.",
          "more": "10–20% overshoot. Fun and bouncy.",
          "demo": {
            "ease": "linear(0, 0.058, 0.196, 0.372, 0.553, 0.717, 0.853, 0.957, 1.028, 1.071, 1.091, 1.094, 1.086, 1.072, 1.055, 1.038, 1.023, 1.011, 1.002, 0.996, 0.992, 0.991, 0.991, 0.992, 0.994, 0.995, 0.997, 0.998, 0.999, 1, 1)",
            "ms": 300,
            "label": "playful"
          }
        },
        {
          "title": "Premium",
          "text": "350–600 ms, no overshoot.",
          "more": "Elegant and calm.",
          "css": "transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);",
          "demo": {
            "ease": "cubic-bezier(0.4, 0, 0.2, 1)",
            "ms": 500,
            "label": "premium"
          }
        },
        {
          "title": "Corporate",
          "text": "200–400 ms, tiny overshoot.",
          "more": "Clean, for dashboards. The default for UI.",
          "css": "transition-timing-function: cubic-bezier(0.2, 0, 0, 1);",
          "demo": {
            "ease": "cubic-bezier(0.2, 0, 0, 1)",
            "ms": 300,
            "label": "corporate"
          }
        },
        {
          "title": "Energetic",
          "text": "100–250 ms, expo ease-out.",
          "more": "15–30% overshoot. Bold.",
          "demo": {
            "ease": "cubic-bezier(0.16, 1, 0.3, 1)",
            "ms": 200,
            "label": "energetic"
          }
        },
        {
          "title": "Brand motion identity",
          "text": "One curve, three durations, one entrance.",
          "more": "A signature easing for 80% of animations, a quick / standard / slow palette, and one entry pattern."
        }
      ],
      "short": "Personality"
    },
    {
      "id": "timing",
      "title": "Timing",
      "type": "cards",
      "intro": "Duration follows element size and distance.",
      "items": [
        {
          "title": "Duration table",
          "text": "Tooltip 80–120 ms, modal 300–400 ms.",
          "more": "Press 120–180 ms, icon 150–250 ms, card 200–350 ms, page 400–600 ms, dramatic reveal 600–1200 ms."
        },
        {
          "title": "Distance scales duration",
          "text": "200 px = 1.3×, 400 px = 1.6×.",
          "more": "100 px is the base."
        },
        {
          "title": "Enter longer than exit",
          "text": "Entrances 30–50% longer.",
          "more": "Users care about what appears.",
          "demo": {
            "ease": "cubic-bezier(0.23, 1, 0.32, 1)",
            "ms": 300,
            "label": "enter 300 ms",
            "vs": {
              "ease": "cubic-bezier(0.23, 1, 0.32, 1)",
              "ms": 200,
              "label": "exit 200 ms"
            }
          }
        },
        {
          "title": "Directional easing",
          "text": "Enter decelerates, exit accelerates.",
          "more": "On-screen moves ease both ends; ambient loops use sine curves."
        }
      ]
    },
    {
      "id": "quality",
      "title": "Before you ship",
      "type": "checklist",
      "intro": "The 8-step check from the skill.",
      "items": [
        "Emotional target named",
        "One personality chosen",
        "Primary property picked",
        "Duration from the table",
        "Easing matches direction",
        "Hero element staged",
        "Secondary and ambient layers considered",
        "No more than a third of elements moving at once"
      ],
      "short": "Checklist"
    }
  ]
}